{
    "family": "default-learning-service",
    "containerDefinitions": [
        {
            "name": "Main",
            "image": "307506883737.dkr.ecr.ap-southeast-1.amazonaws.com/courshare-learning-service@sha256:fd20de8211c56b55e4c661139c1f7b068296668c21b50c49d742b43b9b80794a",
            "cpu": 256,
            "memory": 512,
            "memoryReservation": 512,
            "portMappings": [
                {
                    "containerPort": 8085,
                    "hostPort": 8085,
                    "protocol": "tcp",
                    "name": "main-8083-tcp"
                }
            ],
            "essential": true,
            "command": [],
            "environment": [
                {
                    "name": "DATABASE_URL",
                    "value": "postgresql://learning_user:LearningPassSecure123!@courshare-shared-db.c9ekmoesqqkt.ap-southeast-1.rds.amazonaws.com:5432/learning_db?sslmode=require"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "secrets": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/aws/ecs/default/learning-service-17fa",
                    "awslogs-region": "ap-southeast-1",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ],
    "executionRoleArn": "arn:aws:iam::307506883737:role/service-role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "volumes": [],
    "placementConstraints": [],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    },
    "enableFaultInjection": false
}